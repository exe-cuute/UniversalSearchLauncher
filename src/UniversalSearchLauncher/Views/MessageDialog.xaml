<Window x:Class="UniversalSearchLauncher.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal Search Launcher"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/app.ico"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Margin="20">
        <Border Background="{DynamicResource ShadowPlateBrush}" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.55" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource WindowGlassBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="22,20,22,18">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="36"
                            Height="36"
                            Background="{DynamicResource IconTileBrush}"
                            CornerRadius="10"
                            Margin="0,0,12,0">
                        <Image Source="pack://application:,,,/Assets/app-256.png" Width="28" Height="28" />
                    </Border>

                    <TextBlock x:Name="HeadlineText"
                               Grid.Column="1"
                               Text="Universal Search Launcher"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />

                    <Button Grid.Column="2"
                            Style="{StaticResource IconButtonStyle}"
                            Width="28"
                            Height="28"
                            Click="Close_Click">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                    </Button>
                </Grid>

                <TextBlock x:Name="MessageText"
                           Text="Message"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="19" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="SecondaryButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            Click="Secondary_Click"
                            Visibility="Collapsed" />
                    <Button x:Name="PrimaryButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="100"
                            Click="Primary_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
