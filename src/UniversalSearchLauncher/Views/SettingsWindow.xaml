<Window x:Class="UniversalSearchLauncher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Universal Search Launcher"
        Width="780"
        Height="760"
        MinHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/app.ico"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Grid Margin="18">
        <Border Background="{DynamicResource ShadowPlateBrush}" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.55" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource WindowGlassBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Padding="24,18,18,14"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="38"
                                Height="38"
                                Background="{DynamicResource IconTileBrush}"
                                CornerRadius="10"
                                Margin="0,0,13,0">
                            <Image Source="pack://application:,,,/Assets/app-256.png" Width="30" Height="30" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Настройки" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Universal Search Launcher"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButtonStyle}"
                                Width="32"
                                Height="32"
                                Click="Close_Click">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Content -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,0,24,18">

                        <!-- General -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ОСНОВНЫЕ" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Горячая клавиша" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Нажмите на поле и введите новую комбинацию."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="HotkeyBox"
                                             Grid.Column="1"
                                             Width="210"
                                             Style="{StaticResource SettingsTextBoxStyle}"
                                             IsReadOnly="True"
                                             Cursor="Hand"
                                             TextAlignment="Center"
                                             FontWeight="SemiBold"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                             LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                             ToolTip="Нажмите новую комбинацию, например Ctrl+Alt+K" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Тема оформления" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Системная тема следует настройке Windows."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Системная" Style="{StaticResource PillRadioStyle}" />
                                        <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Тёмная" Style="{StaticResource PillRadioStyle}" />
                                        <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Светлая" Style="{StaticResource PillRadioStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Запускать вместе с Windows" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Добавляет лаунчер в автозагрузку текущего пользователя."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="AutostartToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Скрывать при потере фокуса" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Окно закрывается при клике вне его." Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="HideOnFocusLostToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Показывать поверх полноэкранных приложений" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Разрешить открывать поиск во время игр, видео и презентаций. Кнопка в трее открывает окно всегда."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="FullscreenToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Поисковая система" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Используется для интернет-поиска и подсказок."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="EngineGoogle" GroupName="Engine" Content="Google" Style="{StaticResource PillRadioStyle}" />
                                        <RadioButton x:Name="EngineBing" GroupName="Engine" Content="Bing" Style="{StaticResource PillRadioStyle}" />
                                        <RadioButton x:Name="EngineDuckDuckGo" GroupName="Engine" Content="DuckDuckGo" Style="{StaticResource PillRadioStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Количество результатов" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Сколько строк показывать в поисковом окне."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="MaxResultsSlider"
                                                Width="170"
                                                Minimum="4"
                                                Maximum="15"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Style="{StaticResource AccentSliderStyle}"
                                                ValueChanged="MaxResultsSlider_ValueChanged" />
                                        <Border Width="34" Height="28" Margin="10,0,0,0" Background="{DynamicResource ChipBrush}" CornerRadius="7">
                                            <TextBlock x:Name="MaxResultsValue" Text="8"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Search and index -->
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="ПОИСК И ИНДЕКС" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Приоритет приложений" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Выше — приложения чаще оказываются сверху."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="AppPrioritySlider" Width="150" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource AccentSliderStyle}" ValueChanged="PrioritySlider_ValueChanged" />
                                        <TextBlock x:Name="AppPriorityValue" Text="3" Width="24" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Приоритет файлов" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Влияет на порядок файлов и папок." Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="FilePrioritySlider" Width="150" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource AccentSliderStyle}" ValueChanged="PrioritySlider_ValueChanged" />
                                        <TextBlock x:Name="FilePriorityValue" Text="3" Width="24" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Приоритет интернета" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Показывать интернет-поиск выше или ниже."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="WebPrioritySlider" Width="150" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource AccentSliderStyle}" ValueChanged="PrioritySlider_ValueChanged" />
                                        <TextBlock x:Name="WebPriorityValue" Text="2" Width="24" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Индексируемые папки" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Файлы ищутся только в этих папках и их подпапках."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="AddFolderButton" Content="Добавить" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11.5" Click="AddFolder_Click" />
                                        <Button x:Name="RemoveFolderButton" Content="Удалить" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11.5" Margin="6,0,0,0" Click="RemoveFolder_Click" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="FoldersList" Height="106" Margin="0,8,0,0" Style="{StaticResource SettingsListBoxStyle}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Исключения" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Имена папок, расширения (*.tmp) или маски файлов."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Удалить" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11.5" Click="RemoveExclusion_Click" />
                                </Grid>
                                <ListBox x:Name="ExclusionsList" Height="84" Margin="0,8,0,0" Style="{StaticResource SettingsListBoxStyle}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewExclusionBox"
                                             Grid.Column="0"
                                             Style="{StaticResource SettingsTextBoxStyle}"
                                             ToolTip="Например: node_modules, *.tmp, C:\Users\...\Temp"
                                             PreviewKeyDown="NewExclusionBox_PreviewKeyDown" />
                                    <Button Grid.Column="1"
                                            Content="Добавить"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="7,0,0,0"
                                            Padding="12,6"
                                            Click="AddExclusion_Click" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="IndexSummaryText" Text="Индекс файлов" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Полное пересканирование может занять несколько секунд."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Перестроить индекс"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6"
                                            Click="RebuildIndex_Click"
                                            ToolTip="Сохранить настройки и полностью пересканировать папки" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Data and updates -->
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="ИСТОРИЯ И ОБНОВЛЕНИЯ" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="История поиска" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Запросы используются для быстрых подсказок."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Очистить историю"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="12,6"
                                            Click="ClearHistory_Click" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13" />

                                <TextBlock Text="Канал обновлений" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="URL JSON-манифеста с полями version и url. Необязательно."
                                           Style="{StaticResource SettingDescriptionStyle}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UpdateFeedBox"
                                             Grid.Column="0"
                                             Style="{StaticResource SettingsTextBoxStyle}"
                                             ToolTip="https://example.com/universal-search-launcher/latest.json" />
                                    <Button x:Name="CheckUpdatesButton"
                                            Grid.Column="1"
                                            Content="Проверить"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="7,0,0,0"
                                            Padding="12,6"
                                            Click="CheckUpdates_Click" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="VersionLabel" Text="Версия" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Данные, настройки и индекс хранятся отдельно для пользователя."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Открыть папку данных"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6"
                                            Click="OpenDataFolder_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Изменения вступают в силу после нажатия «Сохранить»."
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="3,13,0,4" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="{DynamicResource FooterBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ValidationText"
                                   Grid.Column="0"
                                   Text=""
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Отмена"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="92"
                                    Margin="0,0,8,0"
                                    Click="Cancel_Click" />
                            <Button x:Name="SaveButton"
                                    Content="Сохранить"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110"
                                    Click="Save_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
