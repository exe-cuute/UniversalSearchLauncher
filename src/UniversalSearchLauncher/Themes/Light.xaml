<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="WindowGlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E9FBFDFF" Offset="0" />
        <GradientStop Color="#EAF4F6FC" Offset="0.5" />
        <GradientStop Color="#EDECF0F8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowGlowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#305B5CF0" Offset="0" />
        <GradientStop Color="#0015C7E8" Offset="0.58" />
        <GradientStop Color="#0015C7E8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#645CF5" Offset="0" />
        <GradientStop Color="#08A6D8" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WindowBorderBrush" Color="#26000000" />
    <SolidColorBrush x:Key="ShadowPlateBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#171A22" />
